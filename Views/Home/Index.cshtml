@model IEnumerable<StudySpeech.Models.NoteModel>
@* This view displays the home page with a list of sample notes. *@
@{
    ViewData["Title"] = "Home Page";
    bool isSignedIn = User.Identity?.IsAuthenticated ?? false;
}

<div class="mx-auto max-w-2xl rounded-xl bg-white p-10 text-center shadow-sm">
    <h1 class="text-3xl font-bold text-teal-900">Welcome to StudySpeech</h1>
    <p class="mt-3 text-gray-600">
        Take notes, tag them, and have them read back to you with AI text-to-speech.
    </p>
    @if (isSignedIn)
    {
        <a asp-controller="Note" asp-action="Index"
           class="mt-6 inline-block rounded-full bg-teal-800 px-6 py-2 text-sm font-medium text-white hover:bg-teal-900">
            Go to my notes
        </a>
    }
    else
    {
        <div class="mt-6 flex items-center justify-center gap-3">
            <a asp-area="Identity" asp-page="/Account/Register"
               class="rounded-full bg-teal-800 px-6 py-2 text-sm font-medium text-white hover:bg-teal-900">
                Create a free account
            </a>
            <a asp-area="Identity" asp-page="/Account/Login"
               class="rounded-full border border-teal-200 px-6 py-2 text-sm font-medium text-teal-800 hover:bg-teal-50">
                Log in
            </a>
        </div>
    }
</div>

@if (!isSignedIn && Model.Any())
{
    <div class="mx-auto mt-8 max-w-3xl">
        <h2 class="mb-4 text-center text-lg font-semibold text-teal-900">See what your notes could look like</h2>
        <div class="flex flex-col gap-4">
            @foreach (var note in Model)
            {
                <div class="relative rounded-md border border-yellow-300 bg-yellow-100 p-4 pr-16 shadow-sm">
                    <h3 class="font-semibold text-teal-950">
                        @note.Title
                    </h3>
                    <p class="mt-1 text-sm text-gray-700">@note.Content</p>

                    @if (note.NoteTags.Any())
                    {
                        <div class="mt-2 flex flex-wrap gap-1">
                            @foreach (var noteTag in note.NoteTags)
                            {
                                <span class="rounded-full bg-yellow-200 px-2 py-0.5 text-xs text-teal-900">#@noteTag.Tag.Name</span>
                            }
                        </div>
                    }

                    <div class="absolute right-3 top-3 flex items-center gap-2">
                        <button type="button" class="speak-sample-btn" data-id="@note.Id" title="Listen with AI">
                            <img src="~/soundicon.png" alt="Listen with AI" class="h-8 w-8" />
                        </button>
                        <audio class="sample-player hidden h-8 max-w-[220px]" data-id="@note.Id" controls preload="none"></audio>
                    </div>
                </div>
            }
        </div>
    </div>

    @section Scripts {
        <script>
            document.querySelectorAll(".speak-sample-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var id = btn.dataset.id;
                    var audio = document.querySelector('.sample-player[data-id="' + id + '"]');

                    if (!audio.src) {
                        audio.src = "/Note/SpeakSample/" + id;
                    }

                    btn.classList.add("hidden");
                    audio.classList.remove("hidden");
                    audio.play();
                });
            });
        </script>
    }
}
