@using Microsoft.AspNetCore.Identity
@* This partial view displays the login/logout links based on the user's authentication status. *@
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="flex flex-col items-center gap-2 text-lg font-medium text-primary sm:flex-row sm:items-center sm:gap-4 sm:text-sm">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a class="hover:text-primary/70" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            Profile
        </a>
    </li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="text-primary hover:text-primary/70">Logout</button>
        </form>
    </li>
}
else
{
    <li><a class="hover:text-primary/70" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
    <li><a class="hover:text-primary/70" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
}
</ul>
