@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="mx-auto max-w-md rounded-xl bg-white p-6 shadow-sm">
    <h1 class="text-xl font-bold text-primary">@ViewData["Title"]</h1>
    <div class="mt-4">
        <section>
            <form id="account" method="post" class="flex flex-col gap-4">
                <h2 class="text-sm text-gray-600">Use a local account to log in.</h2>
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
                <div>
                    <label asp-for="Input.Email" class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                    <input asp-for="Input.Email" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="mb-1 block text-sm font-medium text-gray-700">Password</label>
                    <input asp-for="Input.Password" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>
                <div class="flex items-center gap-2">
                    <input class="h-4 w-4 rounded border-gray-300 accent-primary" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="text-sm font-medium text-gray-700">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-full rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:brightness-90">Log in</button>
                </div>
                <div class="flex flex-col gap-1">
                    <p>
                        <a id="forgot-password" class="text-sm text-primary hover:underline" asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p>
                        <a class="text-sm text-primary hover:underline" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" class="text-sm text-primary hover:underline" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
