@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="mx-auto flex max-w-3xl flex-col gap-6 rounded-xl bg-white p-6 shadow-sm md:flex-row">
    <div class="w-full shrink-0 md:w-56">
        <h1 class="text-xl font-bold text-primary">Manage your account</h1>
        <h2 class="mt-1 text-sm text-gray-600">Change your account settings</h2>
        <div class="mt-4">
            <partial name="_ManageNav" />
        </div>
    </div>
    <div class="flex-1">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
