@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="font-semibold text-primary">@ViewData["Title"]</h3>

<div class="mt-4 rounded-md bg-yellow-50 border border-yellow-200 px-4 py-3 text-sm text-yellow-800" role="alert">
    <p>
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </p>
</div>

<form id="delete-user" method="post" class="mt-4 flex flex-col gap-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div>
            <label asp-for="Input.Password" class="mb-1 block text-sm font-medium text-gray-700"></label>
            <input asp-for="Input.Password" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
            <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
        </div>
    }
    <button class="w-full rounded-full bg-red-600 px-5 py-2 text-sm font-medium text-white hover:bg-red-700" type="submit">Delete data and close my account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
