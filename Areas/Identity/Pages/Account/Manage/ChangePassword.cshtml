@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="font-semibold text-primary">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="change-password-form" method="post" class="mt-4 flex flex-col gap-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
    <div>
        <label asp-for="Input.OldPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
        <input asp-for="Input.OldPassword" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
        <span asp-validation-for="Input.OldPassword" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="Input.NewPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
        <input asp-for="Input.NewPassword" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
        <span asp-validation-for="Input.NewPassword" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="Input.ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
        <input asp-for="Input.ConfirmPassword" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
        <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-red-600"></span>
    </div>
    <button type="submit" class="w-full rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:brightness-90">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
