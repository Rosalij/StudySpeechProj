@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="font-semibold text-primary">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post" class="mt-4 flex flex-col gap-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
    <div>
        <label asp-for="Username" class="mb-1 block text-sm font-medium text-gray-700"></label>
        <input asp-for="Username" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" placeholder="Please choose your username." disabled />
    </div>
    <div>
        <label asp-for="Input.PhoneNumber" class="mb-1 block text-sm font-medium text-gray-700"></label>
        <input asp-for="Input.PhoneNumber" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" placeholder="Please enter your phone number." />
        <span asp-validation-for="Input.PhoneNumber" class="text-sm text-red-600"></span>
    </div>
    <button id="update-profile-button" type="submit" class="w-full rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:brightness-90">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
