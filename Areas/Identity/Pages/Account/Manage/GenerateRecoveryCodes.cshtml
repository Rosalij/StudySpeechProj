@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="font-semibold text-indigo-900">@ViewData["Title"]</h3>
<div class="mt-4 rounded-md bg-yellow-50 border border-yellow-200 px-4 py-3 text-sm text-yellow-800" role="alert">
    <p>
        <strong>Put these codes in a safe place.</strong>
    </p>
    <p class="mt-2">
        If you lose your device and don't have the recovery codes you will lose access to your account.
    </p>
    <p class="mt-2">
        Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
        used in an authenticator app you should <a class="text-indigo-700 hover:underline" asp-page="./ResetAuthenticator">reset your authenticator keys.</a>
    </p>
</div>
<form method="post" class="mt-4">
    <button class="rounded-full bg-red-600 px-5 py-2 text-sm font-medium text-white hover:bg-red-700" type="submit">Generate Recovery Codes</button>
</form>
