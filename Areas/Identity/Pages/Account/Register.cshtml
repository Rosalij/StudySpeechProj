@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="mx-auto max-w-md rounded-xl bg-white p-6 shadow-sm">
    <h1 class="text-xl font-bold text-primary">@ViewData["Title"]</h1>

    <div class="mt-4">
        <section>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="flex flex-col gap-4">
                <h2 class="text-sm text-gray-600">Create a new account.</h2>
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
                <div>
                    <label asp-for="Input.Email" class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                    <input asp-for="Input.Email" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="mb-1 block text-sm font-medium text-gray-700">Password</label>
                    <input asp-for="Input.Password" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary/60 focus:outline-none focus:ring-2 focus:ring-primary/40" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-red-600"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-full rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:brightness-90">Register</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
