@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    var statusMessageClass = isError
        ? "rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800"
        : "rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800";
    <div class="mt-4 @statusMessageClass" role="alert">
        @Model
    </div>
}
