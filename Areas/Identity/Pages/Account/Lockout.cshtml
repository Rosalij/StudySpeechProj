@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<div class="mx-auto max-w-lg rounded-xl bg-white p-6 shadow-sm">
    <header>
        <h1 class="text-xl font-bold text-red-700">@ViewData["Title"]</h1>
        <p class="mt-1 text-sm text-red-600">This account has been locked out, please try again later.</p>
    </header>
</div>
